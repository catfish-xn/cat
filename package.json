{
  "name": "hex-autobattler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --project fast",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:server": "node scripts/build-server.cjs",
    "test:server-entry": "npm run build:server && node scripts/verify-t1-node-entry.cjs",
    "build:game": "esbuild src/server/main.ts src/server/net/test-client.ts --bundle --platform=node --format=esm --target=node22.12 --packages=external --outdir=dist-server/game --out-extension:.js=.mjs --entry-names=[name] --log-level=warning",
    "serve:game": "npm run build:game && node dist-server/game/main.mjs",
    "client:game": "npm run build:game && node dist-server/game/test-client.mjs",
    "dev:online": "run-p --race serve:game dev",
    "preview": "vite preview",
    "test:browser": "node scripts/verify-m5-browser.cjs",
    "test:preview": "node scripts/verify-m5-browser.cjs --preview",
    "test:headless": "node scripts/verify-m5-headless.cjs --multi-seed",
    "test:input": "node scripts/verify-m5-input.cjs",
    "test:input:preview": "node scripts/verify-m5-input.cjs --preview",
    "test:retention": "node scripts/verify-m6-retention.cjs",
    "test:compare": "node scripts/compare-m5-evidence.cjs",
    "test:performance": "node scripts/verify-m5-headless.cjs --repeat=3",
    "test:timing": "vitest run --project timing --no-file-parallelism"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "npm-run-all2": "9.0.3",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
